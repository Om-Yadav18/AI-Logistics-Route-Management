# Backend Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# Copernicus Data Space Ecosystem (CDSE)
# Metadata catalog search is public.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
COPERNICUS_CLIENT_ID=cdse-public

# Copernicus Sentinel Hub Processing API OAuth Credentials
# (Obtained freely under User Settings -> OAuth Clients in the CDSE dashboard)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Default Bounding Box for North Eastern Region (NER) Test Area (Assam / Guwahati)
DEFAULT_BBOX_MIN_LON=91.50
DEFAULT_BBOX_MIN_LAT=26.00
DEFAULT_BBOX_MAX_LON=92.00
DEFAULT_BBOX_MAX_LAT=26.50
